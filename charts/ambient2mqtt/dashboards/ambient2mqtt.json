      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (kind, result) (increase(ambient2mqtt_commands_total{job=~\"$job\"}[$__interval]))",
          "legendFormat": "{{kind}} {{result}}",
          "refId": "A"
