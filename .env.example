# Ambient account (required)
AMBIENT_USERNAME=you@example.com
AMBIENT_PASSWORD=your-password

# MQTT broker
MQTT_HOST=localhost
MQTT_PORT=1883
# MQTT_USERNAME=
# MQTT_PASSWORD=
# MQTT_TLS=false

# Bridge behavior
BASE_TOPIC=ambient2mqtt
DISCOVERY_PREFIX=homeassistant
SYNC_INTERVAL=30
LOG_LEVEL=INFO
# text | json (one JSON object per line, for Loki and other log pipelines)
LOG_FORMAT=text

# Prometheus /metrics plus /healthz and /readyz; 0 disables the HTTP server.
METRICS_PORT=9100

# Re-type devices that aren't what Ambient reports (e.g. a switch driving a ceiling fan).
# JSON: {"<deviceId>": "fan"|"switch"|"light"}
# DEVICE_OVERRIDES={"<device-uuid>":"fan"}
