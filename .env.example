# Ambient account (required)
AMBIENT_USERNAME=you@example.com
AMBIENT_PASSWORD=your-password

# MQTT broker
MQTT_HOST=localhost
MQTT_PORT=1883
# MQTT_USERNAME=
# MQTT_PASSWORD=
# MQTT_TLS=false

# Bridge behavior
BASE_TOPIC=ambient2mqtt
DISCOVERY_PREFIX=homeassistant
SYNC_INTERVAL=30
LOG_LEVEL=INFO
